rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.displayName is string &&
        data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.language in ['ENGLISH', 'TAMIL'] &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time &&
        (!('emergencyContactName' in data) || (data.emergencyContactName is string && data.emergencyContactName.size() <= 100)) &&
        (!('emergencyContactPhone' in data) || (data.emergencyContactPhone is string && data.emergencyContactPhone.size() <= 30)) &&
        (!('largeFontEnabled' in data) || data.largeFontEnabled is bool) &&
        (!('autoTtsEnabled' in data) || data.autoTtsEnabled is bool);
    }

    function isValidScamCheckLog(data, userId) {
      return data.userId == userId &&
        data.type in ['message', 'call'] &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 5000 &&
        data.riskLevel in ['LOW_RISK', 'SUSPICIOUS', 'HIGH_RISK', 'UNKNOWN'] &&
        data.headline is string && data.headline.size() >= 1 && data.headline.size() <= 200 &&
        data.explanation is string && data.explanation.size() >= 1 && data.explanation.size() <= 5000 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        (!('id' in data) || (data.id is string && data.id.size() <= 100)) &&
        (!('flaggedPhrases' in data) || (data.flaggedPhrases is list && data.flaggedPhrases.size() <= 50));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data, userId);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data, userId) &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);

      match /checkLogs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidScamCheckLog(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidScamCheckLog(request.resource.data, userId) &&
                         request.resource.data.createdAt == resource.data.createdAt &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
